<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TestDriver.Core/TestDriver.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The example scenario ships as a test fixture, so CI fails if the sample
         in the README ever drifts out of sync with the parser. -->
    <None Include="../../scenarios/*.scenario" CopyToOutputDirectory="PreserveNewest" LinkBase="Scenarios" />
  </ItemGroup>

</Project>
