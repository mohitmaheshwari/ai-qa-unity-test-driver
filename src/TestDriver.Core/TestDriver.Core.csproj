<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 is what Unity 2021.2+ consumes. Keeping the core here means
         the same DLL runs in CI and inside the Unity player with no #if gymnastics. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>TestDriver.Core</RootNamespace>
  </PropertyGroup>

</Project>
